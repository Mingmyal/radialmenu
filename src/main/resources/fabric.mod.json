{
  "schemaVersion": 1,
  "id": "radialmenu",
  "version": "${version}",
  "name": "RadialMenu",
  "description": "A simple and opinionated Minecraft radial menu mod that works flawlessly out of the box.",
  "authors": [],
  "contact": {
    "sources": "https://github.com/Mingmyal/radialmenu",
    "issues": "https://github.com/Mingmyal/radialmenu/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/radialmenu/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mingmyal.radialmenu.server.RadialServer"
    ],
    "client": [
      "com.mingmyal.radialmenu.RadialClient"
    ],
    "modmenu": [
      "com.mingmyal.radialmenu.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "radialmenu.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "yet_another_config_lib_v3": ">=3.5.0+1.21.1-fabric",
    "modmenu": ">=11.0.0",
    "malilib": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "https://github.com/Mingmyal/radialmenu/releases",
        "modmenu.issues": "https://github.com/Mingmyal/radialmenu/issues"
      }
    }
  },
  "accessWidener": "radialmenu.accessWidener"
}
