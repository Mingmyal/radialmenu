{
  "schemaVersion": 1,
  "id": "radialmenu",
  "version": "${version}",
  "name": "RadialMenu",
  "description": "A simple and opinionated Minecraft radial menu mod that works flawlessly out of the box.",
  "authors": [
    {
      "name": "velolib",
      "contact": {
        "email": "vlocitize@gmail.com",
        "homepage": "https://velolib.dev"
      }
    }
  ],
  "contact": {
    "sources": "https://github.com/velolib/radial",
    "issues": "https://github.com/velolib/radial/issues",
    "homepage": "https://modrinth.com/mod/radial"
  },
  "license": "GPL-3.0",
  "icon": "assets/radialmenu/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.velolib.radialmenu.RadialClient"
    ],
    "modmenu": [
      "dev.velolib.radialmenu.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "radialmenu.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "yet_another_config_lib_v3": ">=3.5.0+1.21.1-fabric",
    "modmenu": ">=11.0.0",
    "malilib": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.modrinth": "https://modrinth.com/mod/radial",
        "modmenu.github_releases": "https://github.com/velolib/radial/releases",
        "modmenu.issues": "https://github.com/velolib/radial/issues"
      }
    }
  },
  "accessWidener": "radialmenu.accessWidener"
}
